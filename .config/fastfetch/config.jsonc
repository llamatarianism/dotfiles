{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
		"color": { "1": "blue", "2": "blue" },
		"padding": { "top": 2, "left": 1 }
    },
    "display": {
		"separator": " ",
        "key": {
            "width": 13,
			"type": "both"
        },
        "bar": {
            "char": {
                "elapsed": "#",
                "total": "."
            },
            "width": 13
        },
        "percent": {
            "type": 2
        }
    },
    "modules": [
		"break",
        "title",
		"os",
		"kernel",
		"host",
		"shell",
		"cpu",
		"gpu",
        "memory",
        {
            "type": "disk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
		"break",
        {
            "type": "colors",
			"symbol": "block",
            "block": {
				"range": [1,6]
			}
        }
    ]
}
