// -*- mode: jsonc -*-
{
    "on_sigusr1": "reload",
    "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "umbriel/workspaces",
        "umbriel/window",
        "sway/workspaces",
        "sway/window",
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "group/tray",
        "custom/weather",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "memory",
        "custom/sep",
        "clock",
    ],

    "umbriel/workspaces": {
        "format": "{index}",
        "hide-empty": true
    },
    "umbriel/window": {
        "format": "{title}",
        "max-length": 70,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - Discord": " $1",
            "(.*) – GIMP": " $1",
            "Limusic": "󰐎 Limusic",
            "vim (.*)": " $1"
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{0:%H:%M %Z} ",
        "format-alt": "{0:%d %b %Y} ",
        "tooltip": false
    },
    "clock#date": {
        "format": "{0:%d %b %Y}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": " {used:0.1f}G"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{icon}",
        "format-ethernet": "{cidr} 󰊗",
        "tooltip-format": "{essid}: {signalStrength}%",
        "format-disconnected": "󰤮",
        "format-icons": [ "󰤟", "󰤢", "󰤥", "󰤨" ]
        
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " X%",
        "tooltip-format": "Volume: {volume}%", // ▒
        "format-icons": {
           "default": [ "", "", "", "" ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute 0 toggle",
        "scroll-step": 2
    },
    "custom/power": {
        "format" : " ",
        "on-click": "$HOME/scripts/power_menu.sh"
    },
    "custom/weather": {
        "format": "{text}",
        "exec": "/home/lune/.config/waybar/weather.py",
        "interval": 120
    },
    "image#album-art": {
        "exec": "~/.config/waybar/album_art.sh",
        "size": 32,
        "interval": 30
    },
    "mpris": {
        "format": " {dynamic}",
        "dynamic-order": ["artist", "title"],
        "max-length": 100
    },
    "custom/sep": {
        "format": "/"
    },
    "custom/drawer": {
        "format": "" 
    },
    "group/tray": {
        "orientation": "horizontal",
        "modules": [
            "custom/drawer",
            "tray"
        ],
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 100
        }
    }
}
